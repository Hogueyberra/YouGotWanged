# This demonstration needs no external provider keys.
# Yahoo OAuth scaffolding exists, but live Fantasy ingest remains gated off.
# Never put credentials in NEXT_PUBLIC_ variables or source control.

# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=https://your-domain.example/api/integrations/yahoo/callback
# YAHOO_TOKEN_ENCRYPTION_KEY=  # 32-byte key as 64-char hex or base64
# YAHOO_APPLICATION_APPROVED=false
# YAHOO_LIVE_CONTRACT_VALIDATED=false
