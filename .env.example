# This demonstration needs no external provider keys.
# Yahoo OAuth remains disabled until approval and a verified provider contract.
# Never put credentials in NEXT_PUBLIC_ variables or source control.
#
# Yahoo OAuth (server-only). All four are required to connect a Yahoo account.
# Register this exact redirect URI on your Yahoo developer app
# (https://developer.yahoo.com/apps, app "You Got Wanged"):
#   https://<your-deployment-domain>/api/integrations/yahoo/callback
# For the temporary deployment the domain is:
#   https://fantasy-front-office-nick.hougeyberra.chatgpt.site/api/integrations/yahoo/callback
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=
# 32 random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Used to AES-GCM-encrypt Yahoo OAuth tokens at rest in D1.
YAHOO_TOKEN_KEY=
